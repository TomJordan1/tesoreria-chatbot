# Ejemplo sin secretos. Copiar a .env local o agregar pares en Render.
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Selección explícita: groq (predeterminado) o deepseek (pago por consumo).
IA_PROVEEDOR=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODELO_VISION=deepseek-flash
DEEPSEEK_MODELO_TEXTO=deepseek-flash
# Para volver a Groq, seleccionar IA_PROVEEDOR=groq y configurar:
# GROQ_API_KEY=tu_clave
# GROQ_MODELO_VISION=identificador_de_un_modelo_con_imagenes_disponible
# GROQ_MODELO_TEXTO=identificador_de_un_modelo_con_JSON_disponible

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SITE_ID=
MS_DRIVE_ID=

# Solo para el modo tradicional de un destino.
MS_ITEM_ID=
MS_TABLE_NAME=REGISTRODIARIO3
MS_USUARIOS_ITEM_ID=
FORMATO_FECHA_EXCEL=PE

# Completar activa proyectos/gestiones. Vacío conserva el modo tradicional.
# ID del Excel central, dentro de MS_DRIVE_ID; puede ser Accesos.xlsx ampliado.
MS_CONFIG_ITEM_ID=
